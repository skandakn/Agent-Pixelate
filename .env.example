# ==============================================================================
# Agent Pixelate — Unified Production Environment Template
# Copy to `.env` and configure keys before running Docker Compose or deployment.
# All production secrets should be managed via your cloud secrets manager
# (e.g. AWS Secrets Manager, GCP Secret Manager, HashiCorp Vault, or Render Secret Groups).
# ==============================================================================

# --- Runtime & Networking ---
ENVIRONMENT=development
LOG_LEVEL=INFO
ORCHESTRATOR_PORT=8000
AGENTS_PORT=8001
FRONTEND_PORT=3000
ORCHESTRATOR_PUBLIC_URL=http://localhost:8000
AGENTS_SERVICE_URL=http://agents:8001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://frontend:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Persistent media & campaign state volume (mounted at /data/campaigns in Docker)
CAMPAIGN_DATA_DIR=/data/campaigns

# --- Sponsor 1: BAND Multi-Agent Protocol (https://band.ai) ---
# Leave BAND_API_KEY blank in local dev to activate the async in-memory event bus fallback.
BAND_API_KEY=
BAND_VISUAL_AGENT_KEY=
BAND_COPY_AGENT_KEY=
BAND_REST_URL=https://app.band.ai
BAND_WS_URL=wss://app.band.ai/api/v1/socket/websocket
BAND_FALLBACK_ON_ERROR=true
ENABLE_LOCAL_AGENT_FALLBACK=true

# --- Sponsor 2: Agent37 Cloud Sandbox (https://agent37.com) ---
AGENT37_API_KEY=
AGENT37_API_BASE=https://api.agent37.com/v1
AGENT37_TEMPLATE_NAME=agent-pixelate-orchestrator
AGENT37_INSTANCE_NAME=agent-pixelate-orchestrator-prod
AGENT37_VOLUME_NAME=pixelate-campaign-assets

# --- Sponsor 3 & 4: ADAL & Finch ---
ADAL_API_KEY=
FINCH_API_KEY=

# --- Foundation Model Providers ---
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- Automated Video Engine ---
AUTO_RENDER_VIDEO=true

# --- Authentication (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Production Secrets Management ---
# Provider options: 'env' (default), 'aws_secrets', 'gcp_secrets', 'vault'
SECRETS_PROVIDER=env
SECRETS_VAULT_ADDR=
SECRETS_VAULT_TOKEN=
