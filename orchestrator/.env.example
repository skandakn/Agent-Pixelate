# ==============================================================================
# Agent Pixelate — Orchestrator Backend Configuration
# Copy this file to `orchestrator/.env` for local standalone development.
# ==============================================================================

# Server Network Configuration
ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO
ORCHESTRATOR_PUBLIC_URL=http://localhost:8000
AGENTS_SERVICE_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Persistent Data Storage Volume
CAMPAIGN_DATA_DIR=./data/campaigns

# Multi-Agent Collaboration Protocol (BAND)
BAND_API_KEY=
BAND_REST_URL=https://app.band.ai
BAND_WS_URL=wss://app.band.ai/api/v1/socket/websocket
BAND_FALLBACK_ON_ERROR=true
ENABLE_LOCAL_AGENT_FALLBACK=true

# Foundation AI Models (Gemini & OpenAI)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
OPENAI_API_KEY=

# Automated Video Engine
AUTO_RENDER_VIDEO=true

# Security & Secrets Management (Supports 'env', 'aws_secrets', 'gcp_secrets', 'vault')
SECRETS_PROVIDER=env
