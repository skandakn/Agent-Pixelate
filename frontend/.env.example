# ==============================================================================
# Agent Pixelate — Frontend Environment Configuration
# Copy this file to `frontend/.env.local` for local development.
# ==============================================================================

# Backend API & WebSocket URLs (Defaults to FastAPI running on localhost:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Authentication (Clerk - optional in local preview, activated when configured)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Studio Defaults
NEXT_PUBLIC_DEFAULT_PLATFORMS=instagram,linkedin,meta_ads
